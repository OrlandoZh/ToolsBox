# Copy this file to .env.local and adjust the paths for your machine.

# Optional on macOS if Zotero is installed in /Applications/Zotero.app.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero

# Optional. If omitted, the runner creates isolated paths inside .zotero-runtime/<mode>/.
# ZOTERO_PLUGIN_PROFILE_PATH=/absolute/path/to/zotero/profile
# ZOTERO_PLUGIN_DATA_DIR=/absolute/path/to/zotero/data

# Optional fixed port for Zotero's RDP server.
# ZOTERO_PLUGIN_RDP_PORT=64719

# Optional polling interval for zotero:watch (milliseconds).
# ZOTERO_PLUGIN_WATCH_INTERVAL_MS=1000

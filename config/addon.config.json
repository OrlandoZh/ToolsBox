{
  "addonName": "ToolsBox",
  "addonId": "toolsbox@orlandozh.github",
  "addonRef": "toolsbox",
  "addonVersion": "0.1.0",
  "description": "A clean-room Zotero workflow toolbox.",
  "author": "OrlandoZh",

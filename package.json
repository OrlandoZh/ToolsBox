{
  "name": "zotero-cleanroom-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "export:project": "node scripts/export-project.mjs",
    "verify": "node scripts/verify.mjs",
    "cleanroom:sim": "node scripts/cleanroom-similarity.mjs",
    "cleanroom:audit": "node scripts/cleanroom-audit.mjs",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:matrix": "node scripts/release-matrix.mjs",
    "release:install-smoke": "node scripts/release-install-smoke.mjs --channel stable",
    "release:install-smoke:stable": "node scripts/release-install-smoke.mjs --channel stable",
    "release:install-smoke:beta": "node scripts/release-install-smoke.mjs --channel beta",
    "release:local": "npm run package && npm run release:preflight",
    "release:plan": "npm run release:local && npm run release:prepare && npm run release:matrix",
    "agent:run": "node scripts/agent-runner.mjs",
    "agent:monitor": "node scripts/agent-monitor.mjs",
    "agent:dashboard": "npm run agent:monitor && node scripts/agent-dashboard.mjs",
    "agent:obsidian": "node scripts/agent-obsidian-handoff.mjs",
    "agent:gate": "npm run agent:monitor && node scripts/agent-gate.mjs --profile dev",
    "agent:gate:release": "npm run agent:monitor && node scripts/agent-gate.mjs --profile release",
    "agent:report": "npm run agent:check && npm run agent:dashboard",
    "agent:pipeline": "npm run agent:check && npm run agent:release && npm run agent:dashboard && npm run agent:gate:release",
    "agent:zotero:e2e": "node scripts/agent-zotero-e2e.mjs --cycles 2 --strategy hot",
    "agent:zotero:e2e:restart": "node scripts/agent-zotero-e2e.mjs --cycles 2 --strategy restart",
    "agent:zotero:e2e:update-baseline": "node scripts/agent-zotero-e2e.mjs --cycles 2 --strategy hot --update-visual-baseline",
    "agent:zotero:loop": "node scripts/agent-zotero-loop.mjs",
    "agent:zotero:loop:human": "node scripts/agent-zotero-loop.mjs --human-window-ms 60000",
    "agent:zotero:watch-recovery": "node scripts/zotero-watch-recovery-regression.mjs",
    "agent:zotero:autofix": "node scripts/agent-zotero-autofix.mjs --cycles 2 --strategy hot --max-attempts 4",
    "agent:check": "node scripts/agent-runner.mjs check -- npm run check",
    "agent:memory": "node scripts/agent-memory.mjs",
    "agent:delegate:list": "node scripts/agent-delegation.mjs list",
    "agent:delegate:run": "node scripts/agent-delegation.mjs run",
    "agent:delegate:review": "node scripts/agent-delegation.mjs review",
    "agent:delegate:close": "node scripts/agent-delegation.mjs close",
    "agent:release": "node scripts/agent-runner.mjs release-plan -- npm run release:plan",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run verify && npm run cleanroom:audit && npm test",
    "test": "node tests/run-all.js",
    "sim": "npm run cleanroom:sim",
    "zotero:dev": "node scripts/zotero.mjs dev",
    "zotero:console": "node scripts/zotero.mjs console",
    "zotero:watch": "node scripts/zotero.mjs watch",
    "zotero:smoke": "node scripts/zotero.mjs smoke",
    "zotero:test": "node scripts/zotero.mjs test",
    "zotero:scenario": "node scripts/zotero.mjs scenario"
  }
}
